#!/bin/bash
# Stop standby BirdNET-Go and prepare its DB for return to pi-4-birdnet. Added 06/11/2026.
set -uo pipefail
APP=/srv/birdnet-go-app
die(){ echo "birdnet-handback: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run with sudo"
systemctl is-active --quiet birdnet-go || die "BirdNET-Go is not running here; nothing to hand back"
echo "1/3 Stopping and disabling standby BirdNET-Go"
systemctl disable --now birdnet-go
echo "2/3 Writing a consistent copy of the takeover DB"
install -d -o 1000 -g 1000 -m 700 "$APP/handback"
sqlite3 "$APP/data/birdnet.db" ".backup '$APP/handback/birdnet.db'" || die "sqlite .backup failed"
[ "$(sqlite3 "$APP/handback/birdnet.db" 'PRAGMA integrity_check;')" = ok ] || die "integrity check failed"
chown 1000:1000 "$APP/handback/birdnet.db"
echo "3/3 Done here. Next, from the Mac (keys for both Pis):"
cat <<'MSG'
  1. Move the USB sound card and Clippy back to pi-4-birdnet.
  2. ssh pi@192.168.4.37 'sudo systemctl stop birdnet-go'
  3. scp -3 pi@192.168.7.229:/srv/birdnet-go-app/handback/birdnet.db pi@192.168.4.37:/srv/birdnet-go-app/data/birdnet.db.handback
  4. ssh pi@192.168.4.37 'cd /srv/birdnet-go-app/data && for f in birdnet.db birdnet.db-wal birdnet.db-shm; do [ -f $f ] && mv $f $f.pre-handback; done; mv birdnet.db.handback birdnet.db && sudo systemctl start birdnet-go'
  5. Repoint pi-0-frame and HA links back to 192.168.4.37.
Or ask Claude to run the handback via pi-fleet.
MSG
