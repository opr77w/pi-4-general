[Unit]
# Warm standby copy of pi-4-birdnet's unit (06/11/2026). DISABLED by default; started only by birdnet-takeover.
Description=BirdNET-Go (standby)
After=docker.service
Requires=docker.service

[Service]
Restart=always
ExecStartPre=-/usr/bin/docker rm -f birdnet-go
ExecStartPre=/bin/mkdir -p /srv/birdnet-go-app/config/hls
ExecStartPre=/bin/sh -c 'mount -t tmpfs -o size=50M,mode=0755,uid=1000,gid=1000,noexec,nosuid,nodev tmpfs /srv/birdnet-go-app/config/hls || true'
ExecStartPre=/bin/bash -c 'for interface in /sys/class/net/wlan* /sys/class/net/wlp*; do if [ -d "$interface" ]; then iface=$(basename "$interface"); (command -v iw >/dev/null 2>&1 && iw dev "$iface" set power_save off 2>/dev/null) || true; fi; done'
ExecStart=/usr/bin/docker run --rm \
    --name birdnet-go \
    -p 8080:8080 \
    --env TZ="Europe/London" \
    --env BIRDNET_UID=1000 \
    --env BIRDNET_GID=1000 \
    --device /dev/snd \
    -v /srv/birdnet-go-app/config:/config \
    -v /srv/birdnet-go-app/data:/data \
    -v /sys/class/thermal:/sys/class/thermal \
    -v /run/avahi-daemon:/run/avahi-daemon:ro \
    -v /run/dbus:/run/dbus:ro \
    -v /srv/birdnet-go-app/external:/external \
    ghcr.io/tphakala/birdnet-go:standby
ExecStopPost=/bin/sh -c 'umount -f /srv/birdnet-go-app/config/hls || true'
ExecStopPost=-/usr/bin/docker rm -f birdnet-go

[Install]
WantedBy=multi-user.target
